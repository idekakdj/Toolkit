{
  "name": "toolkit",
  "version": "1.4.0",
  "description": "Toolkit: Sigma, Pigment, ImageVendor and Placeholder with shared authentication.",
  "author": "Toolkit",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/start.cjs",
    "start:hosted": "node server/hosted.cjs",
    "dev": "node server/start.cjs",
    "test": "node test/run-all.cjs",
