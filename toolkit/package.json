    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "global-agent": "4.1.3",
    "minimatch@>=7.0.0 <11.0.1": "11.0.9"
  }
