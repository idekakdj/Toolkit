# Toolkit local settings. Copy this file to toolkit/.env and fill in the values.
# toolkit/.env is git-ignored and must never be committed or shared: it holds secrets.
# Variables already set in the real environment take priority over this file.
# Restart Toolkit (npm start) after changing it.

# --- Google sign-in -----------------------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > Create credentials > OAuth client ID
#   Application type: Web application
#   Authorized redirect URIs (add both, so either address works):
#     http://127.0.0.1:4310/api/auth/google/callback
#     http://localhost:4310/api/auth/google/callback
#   For a hosted server, add  https://<your domain>/api/auth/google/callback  instead.
# Leave these empty to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: use exactly this redirect URI instead of the address Toolkit was opened on.
#GOOGLE_REDIRECT_URI=http://127.0.0.1:4310/api/auth/google/callback

# --- Email (optional): needed for email-and-password sign-ups ------------------------------
# New email/password accounts confirm their address with an emailed 6-digit code, so without
# mail those sign-ups stay paused (Google sign-in still works). Instead of this line you can
# run  node scripts/setup-mail.cjs  which stores the settings in the data folder.
#TOOLKIT_SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com:465
#TOOLKIT_MAIL_FROM="Toolkit <you@gmail.com>"

# --- Email address checks (defaults shown) ------------------------------------------------
#TOOLKIT_EMAIL_DNS_CHECK=on          # 'off' skips DNS lookups (air-gapped installs only)
#TOOLKIT_EMAIL_PROVIDER_CHECK=on     # 'off' accepts any deliverable domain, not only established providers
