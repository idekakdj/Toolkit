# Replace hostname and certificate paths. Run Node on this same host.
# The three limit_* zones below belong in the http {} context (for example a file in conf.d/).
limit_req_zone  $binary_remote_addr zone=toolkit_auth:10m rate=10r/m;    # sign-in / sign-up / reset
limit_req_zone  $binary_remote_addr zone=toolkit_api:10m  rate=300r/m;   # everything else under /api
limit_conn_zone $binary_remote_addr zone=toolkit_conn:10m;

server {
    listen 80;
    server_name toolkit.example.com;
    server_tokens off;
    return 301 https://toolkit.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name toolkit.example.com;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/toolkit.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/toolkit.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;            # modern clients choose; TLS 1.3 suites are all strong
    ssl_session_cache shared:toolkit_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;                  # no long-lived ticket keys that undermine forward secrecy
    ssl_stapling on;
    ssl_stapling_verify on;

    # Slow-client (Slowloris-style) protection, on top of Node's own timeouts.
    client_header_timeout 15s;
    client_body_timeout 30s;
    send_timeout 30s;
    keepalive_timeout 15s;
    large_client_header_buffers 4 8k;
    limit_conn toolkit_conn 40;

    # Largest legitimate request: an ImageVendor document (the API's own limit is 27 MB).
    client_max_body_size 27m;

    # The local runtime control endpoint is never reachable from outside.
    location /__toolkit_runtime { return 404; }

    # Dotfiles, backups and anything that should never be public.
    location ~ /\.(?!well-known) { return 404; }

    # Authentication endpoints: small bodies and a strict request rate. (The application
    # additionally limits failed sign-ins and locks accounts; this is the outer shield.)
    location /api/auth/ {
        limit_req zone=toolkit_auth burst=20 nodelay;
        limit_req_status 429;
        client_max_body_size 32k;
        proxy_pass http://127.0.0.1:4310;
        proxy_set_header Host toolkit.example.com;
        # Overwrite client-supplied forwarding headers at this trusted edge.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }

    location /api/ {
        limit_req zone=toolkit_api burst=100 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:4310;
        proxy_set_header Host toolkit.example.com;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }

    location / {
        client_max_body_size 1m;              # pages and assets never accept uploads
        proxy_pass http://127.0.0.1:4310;
        proxy_set_header Host toolkit.example.com;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
