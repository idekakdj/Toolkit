# Copy to /etc/toolkit/toolkit.env, then:  chown root:root /etc/toolkit/toolkit.env && chmod 600 /etc/toolkit/toolkit.env
# Never commit the real file. Values below are placeholders.

# --- Encryption at rest (strongly recommended) --------------------------------------------
# 32 random bytes, base64. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACK THIS KEY UP SEPARATELY from the data: without it the database cannot be read.
TOOLKIT_DATA_KEY=
# While rotating: put the OLD key here and the NEW key above, restart once, then remove this line.
#TOOLKIT_DATA_KEY_PREVIOUS=

# --- Email: address verification and password reset ---------------------------------------
# Without this, signups are not proven to own their address and passwords cannot be reset by email.
#TOOLKIT_SMTP_URL=smtps://user:password@smtp.example.com:465
#TOOLKIT_MAIL_FROM="Toolkit <no-reply@toolkit.example.com>"

# --- Privacy ------------------------------------------------------------------------------
# Shown in the privacy notice as the person/team users contact for access, correction or complaints.
#TOOLKIT_PRIVACY_CONTACT=privacy@example.com

# --- Tuning (defaults shown) --------------------------------------------------------------
#TOOLKIT_SESSION_IDLE_HOURS=12      # sign out after this long without use
#TOOLKIT_SESSION_MAX_DAYS=7         # hard lifetime, however active
#TOOLKIT_AUDIT_RETENTION_DAYS=365   # security log retention (minimum 30)
#TOOLKIT_USER_QUOTA_MB=512          # per-account storage limit; 0 disables
#TOOLKIT_EMAIL_DNS_CHECK=on         # 'off' skips the signup DNS lookup (air-gapped installs only)

# --- Google sign-in (optional) -------------------------------------------------------------
# Google Cloud Console > Credentials > OAuth client ID (Web application). Authorized redirect URI:
#   https://<your domain>/api/auth/google/callback   (built from TOOLKIT_PUBLIC_URL)
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#TOOLKIT_EMAIL_PROVIDER_CHECK=on     # 'off' accepts any deliverable domain, not only established providers
